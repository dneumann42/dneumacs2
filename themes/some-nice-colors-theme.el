      (bg        "#0b0806")  ; canvas
      (bg-dim    "#070504")  ; sunken: inactive mode line, gutters
      (bg-alt    "#160f0c")  ; raised: mode line, popups, tooltips
      (bg-block  "#110c09")  ; code blocks and quoted prose
      (bg-line   "#150e0b")  ; the current line
      (bg-note   "#191211")  ; panelling behind comments and docs
      (bg-glow   "#241a15")  ; hover and transient highlight
      (sel       "#5c2130")  ; the region -- signature maroon
      (sel-dim   "#3a1a22")  ; secondary selection, other search hits
      (border    "#2c201b")  ; boxes, dividers, popup frames
      (border-hi "#4b352b")  ; borders that should be noticed
      ;; Ink
      (fg        "#ded0c4")  ; body text
      (fg-alt    "#b7a698")  ; quieter text, variable uses
      (fg-dim    "#8c7e73")  ; metadata, annotations, punctuation
      (faint     "#55493f")  ; line numbers, rules, furniture
      (comment   "#9e8d80")  ; comments -- lifted, panelled by bg-note
      (doc       "#bda88c")  ; docstrings
      ;; Accents
      (rose      "#c4707f")  ; definitions and headings -- dusty maroon
      (rose-dim  "#9d5c6a")  ; calls, comment ticks, quieter maroon
      (red       "#c85f63")  ; errors
      (grass     "#94c47b")  ; keywords -- dusty grass green
      (green     "#8bbd6f")  ; success and additions
      (peach     "#eeae76")  ; strings
      (amber     "#e0ac62")  ; types and warnings
      (orange    "#d68f5c")  ; numbers and operators
      (blue      "#86b8d4")  ; variables
      (blue-dim  "#6d9ab4")  ; properties and fields
      (teal      "#7cc4ad")  ; constants and escapes
      (violet    "#b294cd")  ; builtins, macros, pragmas
      (cursor    "#eeae76")  ; the point
      ;; Version control
      (add-bg    "#12190e")  ; added lines
      (del-bg    "#221110")  ; removed lines
      (chg-bg    "#1f180d")  ; changed lines
      (add-hi    "#182310")  ; added lines inside the current hunk
      (del-hi    "#2c1614")  ; removed lines inside the current hunk
      (chg-hi    "#2a2110")) ; changed lines inside the current hunk
